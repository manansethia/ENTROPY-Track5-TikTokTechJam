# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
.env
.env.*
!.env.example
.ipynb_checkpoints/

# Checkpoint and weight files (>50MB)
*.pth
*.pt
*.bin
*.ckpt
*.safetensors
*.onnx
*.engine
checkpoints/

# Large datasets, storage & heavy manifests (>50MB)
data/
datasets/
features/
manifests/
*.jsonl
reports/*_manifest.json
/mnt/
*.parquet
*.tar
*.zip
*.gz
*.iso

# Logs & temp files
logs/
*.log
.DS_Store
runtime/
.codex-backups/
.pytest_cache/
native_apps/

# Sensitive keys
*.pem
*.key
id_rsa
id_ed25519
id_ecdsa

# Ignore all loose/scrap images by default (except brand banner and UI textures)
*.jpg
*.jpeg
*.png
*.webp
*.gif
!assets/brand_cards.jpg
!frontend/assets/*.jpg
!frontend/assets/*.png
!frontend/assets/*.svg
!frontend/assets/materials/*.jpg
!deployment/frontend/assets/*.jpg
